<Window
    x:Class="SocialDashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Social Dashboard">

    <Grid
        Background="#111827"
        Padding="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Social Dashboard"
                Foreground="White"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Local video library"
                Foreground="#94A3B8"
                FontSize="18"/>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Spacing="12"
            Margin="0,24,0,20">

            <TextBox
                x:Name="VideoUrlTextBox"
                PlaceholderText="Paste a YouTube, TikTok, Instagram, or direct video URL"
                MinWidth="620"/>

            <CheckBox
                x:Name="PermissionCheckBox"
                Content="I own or have permission to download and reuse this content."
                Foreground="#CBD5E1"
                Margin="0,8,0,4"/>

            <StackPanel
                Orientation="Horizontal"
                Spacing="12">

                <Button
                    Content="Download platform URL"
                    Click="DownloadPlatformVideoButton_Click"/>

                <Button
                    Content="Download direct file URL"
                    Click="DownloadVideoButton_Click"/>
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="12">

                <Button
                    Content="Import local video"
                    Click="ImportVideoButton_Click"/>

                <Button
                    Content="Refresh library"
                    Click="RefreshLibraryButton_Click"/>
            </StackPanel>
        </StackPanel>

        <Border
            Grid.Row="2"
            Background="#1E293B"
            CornerRadius="12"
            Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Imported videos"
                    Foreground="White"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,16"/>

                <ListView
                    Grid.Row="1"
                    x:Name="VideoListView"
                    Background="Transparent"
                    BorderThickness="0">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="#334155"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="5">

                                        <TextBlock
                                            Text="{Binding FileName}"
                                            Foreground="White"
                                            FontSize="16"
                                            FontWeight="SemiBold"/>

                                        <TextBlock
                                            Text="{Binding ImportStatus}"
                                            Foreground="#34D399"
                                            FontSize="13"/>

                                        <TextBlock
                                            Text="{Binding LocalFilePath}"
                                            Foreground="#94A3B8"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Spacing="5">

                                        <TextBlock
                                            Text="{Binding FileSizeBytes}"
                                            Foreground="#CBD5E1"
                                            FontSize="13"
                                            HorizontalAlignment="Right"/>

                                        <TextBlock
                                            Text="{Binding CreatedAtUtc}"
                                            Foreground="#94A3B8"
                                            FontSize="12"
                                            HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="2"
                    x:Name="StatusText"
                    Text="Loading library..."
                    Foreground="#CBD5E1"
                    Margin="0,16,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>