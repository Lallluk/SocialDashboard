<Window
    x:Class="SocialDashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Social Dashboard">

    <Grid
        Background="#111827"
        Padding="40">

        <StackPanel
            Spacing="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="Social Dashboard"
                Foreground="White"
                FontSize="32"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Local video library"
                Foreground="#94A3B8"
                FontSize="18"
                HorizontalAlignment="Center"/>

            <Button
                Content="Import local video"
                Click="ImportVideoButton_Click"
                HorizontalAlignment="Center"/>

            <TextBlock
                x:Name="StatusText"
                Text="No video imported yet."
                Foreground="#CBD5E1"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>